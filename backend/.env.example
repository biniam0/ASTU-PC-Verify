# Server
PORT=5000
CORS_ORIGIN=http://localhost:3000

# PostgreSQL (Neon)
DATABASE_URL=

# Auth
JWT_SECRET=your-strong-jwt-secret
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15

# Students
# Regex used to validate student IDs (edit to match university standard)
STUDENT_ID_REGEX=^[0-9]{4}\/[0-9]{5}$
# Comma-separated list of allowed departments (e.g. CSE,ME,ECE)
STUDENT_DEPARTMENTS=CSE,ME,ECE,EPCE,SE

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Alerts
# Time window (minutes) to treat duplicate alerts as repeats for the same student/type/gate
ALERT_DUPLICATE_WINDOW_MINUTES=10
